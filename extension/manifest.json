{
  "manifest_version": 3,
  "name": "KeepKeep – Downloader & Anonymous Story Viewer for Instagram",
  "short_name": "KeepKeep",
  "version": "1.0.0",
  "description": "Save Instagram profiles and posts to your own lists, download photos and videos in full quality, and watch stories anonymously.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KeepKeep",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "stories-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "veil.js"
      ],
      "run_at": "document_start",
      "css": [
        "veil.css"
      ]
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "basket.js",
        "instagram.js",
        "panel.js",
        "content.js",
        "buttons.js",
        "video.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
